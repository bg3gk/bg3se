<?xml version="1.0" encoding="utf-8"?>
<!-- Imported after the C++ targets of every project by se-fork\build.cmd.
     libprotobuf-lite v36 needs abseil and utf8_range, which BG3Extender.vcxproj does not list;
     they are added here so the project file stays as upstream has it. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup Condition="'$(ProjectName)' == 'BG3Extender'">
    <ClCompile>
      <!-- stb_image decodes the image files mods bring (IMGUIManager::RegisterFileTexture) -->
      <AdditionalIncludeDirectories>$(SolutionDir)External\stb;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- The fast mode of build.cmd: without whole-program optimisation the big translation
           units exceed the object file's section limit unless /bigobj is given -->
      <AdditionalOptions Condition="'$(GateKitFast)' == 'true'">/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(SolutionDir)External\protobuf-build\third_party\utf8_range\Release\libutf8_validity.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\base\Release\absl_base.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\base\Release\absl_log_severity.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\base\Release\absl_malloc_internal.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\base\Release\absl_raw_logging_internal.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\base\Release\absl_spinlock_wait.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\base\Release\absl_strerror.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\base\Release\absl_throw_delegate.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\base\Release\absl_tracing_internal.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\container\Release\absl_hashtablez_sampler.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\container\Release\absl_raw_hash_set.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\crc\Release\absl_crc32c.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\crc\Release\absl_crc_cord_state.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\crc\Release\absl_crc_cpu_detect.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\crc\Release\absl_crc_internal.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\debugging\Release\absl_debugging_internal.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\debugging\Release\absl_decode_rust_punycode.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\debugging\Release\absl_demangle_internal.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\debugging\Release\absl_demangle_rust.lib;$(SolutionDir)External\protobuf-build\_deps\absl-build\absl\debugging\Release\absl_examine_stack.lib;$(SolutionDir